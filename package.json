{
  "name": "suivi-candidatures",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:unit": "vitest run tests/unit",
    "test:integration": "dotenv -e .env.test -o -- vitest run tests/integration",
    "test": "npm run test:unit && npm run test:integration",
